# === Base de datos (PostgreSQL) ===
POSTGRES_DB=uniticket
POSTGRES_USER=uniticket
POSTGRES_PASSWORD=cambia-esta-clave

# === Django ===
# En produccion genera una clave fuerte con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# En desarrollo (DEBUG=True) puedes dejarla vacia: se genera una temporal.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Solo en produccion DETRAS de un proxy con TLS/HTTPS:
# SECURE_HTTPS=True
